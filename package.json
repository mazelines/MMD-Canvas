{
  "name": "mmd-converter",
  "version": "0.8.0",
  "description": "PMX(MMD) -> FBX / USD converter with 3D file viewer & browser",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "mmdconv": "cli.js"
  },
  "scripts": {
    "start": "electron .",
    "build:dx12": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-dx12.ps1",
    "convert": "node cli.js",
    "test": "node tests/run-tests.js",
    "test:ui": "electron tests/material-panel-smoke.cjs",
    "test:dx12": "electron tests/dx12-ui-smoke.cjs",
    "test:cortao": "electron tests/dx12-cortao-smoke.cjs",
    "test:presentation": "electron tests/dx12-presentation-smoke.cjs",
    "test:lifetime": "electron tests/dx12-lifetime-smoke.cjs",
    "test:zoom": "electron tests/dx12-zoom-profile.cjs",
    "test:dlss": "electron tests/dx12-aa-smoke.cjs",
    "test:shader-stack": "electron tests/dx12-shader-stack-smoke.cjs",
    "test:shader-ui": "electron tests/shader-stack-ui-smoke.cjs",
    "test:grid": "electron tests/dx12-grid-smoke.cjs",
    "test:open": "electron tests/open-file-smoke.cjs",
    "test:first-run": "electron tests/first-run-smoke.cjs",
    "test:workspace": "node tests/run-workspace-ui.cjs",
    "pack": "electron-builder --dir --publish never",
    "prepack": "npm run build:dx12",
    "predist": "npm run build:dx12",
    "dist": "electron-builder --publish never"
  },
  "license": "MIT",
  "author": "mazelines",
  "repository": {
    "type": "git",
    "url": "https://github.com/mazelines/MMD-Canvas.git"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.2",
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  }
}
